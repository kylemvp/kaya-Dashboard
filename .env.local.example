# Copy to .env.local and fill in from your Supabase project
# (Supabase dashboard → Settings → API).
#
# .env.local must never be committed.

# ── Public ───────────────────────────────────────────────────
# Shipped in the browser bundle. That is expected and safe: the anon key is a
# public identifier, and access is controlled by the RLS policies in
# supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Server only ──────────────────────────────────────────────
# Bypasses RLS entirely. Used by `npm run seed` and, optionally, by the build
# snapshot. NEVER prefix this with NEXT_PUBLIC_ and never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
